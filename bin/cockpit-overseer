#!/usr/bin/env python3
"""
cockpit-overseer — compact overseer helper for delta-only cockpit loops.

Subcommands:
  start     Atomically initialize and validate the explicit VP3 control store.
  tick      Persist and deliver at most one controller-owned action, then exit.
  loop      Print only changed worker pane tails since the last snapshot.
  status    Print a one-shot compact snapshot without updating state.
  dispatch  Refuse the retired direct mission-dispatch bypass.
  reset     Clear stored pane state for a session or all sessions.

State is stored at ~/.config/cockpit-overseer/state.json.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from contextlib import ExitStack
from pathlib import Path
from typing import Dict, List, Optional, Tuple
from cockpit_footprint import queue_lock
from cockpit_control_controller import _scope_conflict

from cockpit_control import (
    CONTROLLER_LIVE_REACHABLE,
    CONTROLLER_LIVE_UNOBSERVED,
    CONTROLLER_LIVE_UNREACHABLE,
    CONTROLLER_ACTION_DISPATCH,
    CONTROLLER_PANE_UNOBSERVED,
    MISSION_FOLD_RETAINED_DUPLICATE,
    MISSION_SLOT_RESERVED,
    ControllerDiagnostic,
    ControllerTickResult,
    ControlStoreError,
    PortableControlLock,
    controller_tick,
    fold_mission_state,
    fold_commands,
    dispatch_payload_digest,
    initialize_control_store,
    inspect_control_events,
    observe_queue,
    utc_timestamp,
    report_controller_tick,
    resolve_control_root,
    validate_control_authority,
    validate_control_store,
)

STATE_DIR = Path.home() / ".config" / "cockpit-overseer"
STATE_FILE = STATE_DIR / "state.json"
ARCHIVE_DIR = STATE_DIR / "archive"
ARCHIVE_INDEX = ARCHIVE_DIR / "index.jsonl"
ARCHIVE_SESSIONS = ARCHIVE_DIR / "sessions"
DEFAULT_WINDOWS = ["worker-test", "worker-dev", "worker-fix"]
PASTE_SETTLE_SECONDS = 1
TRACE_ID_PATTERN = r"(?:TRACE-ID|TRACE_ID):\s*([0-9a-fA-F-]{36})"
PARENT_TRACE_ID_PATTERN = r"(?:PARENT-TRACE-ID|PARENT_TRACE_ID):\s*([0-9a-fA-F-]{36})"


def load_state() -> Dict[str, dict]:
    if not STATE_FILE.exists():
        return {"panes": {}}
    try:
        with STATE_FILE.open() as fh:
            data = json.load(fh)
    except (json.JSONDecodeError, ValueError, OSError):
        return {"panes": {}}
    if "panes" not in data or not isinstance(data["panes"], dict):
        data["panes"] = {}
    return data


def save_state(state: Dict[str, dict]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".json.tmp")
    with tmp.open("w") as fh:
        json.dump(state, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, STATE_FILE)


def tmux(*args: str) -> str:
    proc = subprocess.run(
        ["tmux", *args],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip() or "tmux command failed")
    return proc.stdout


def capture(session: str, window: str) -> str:
    return tmux("capture-pane", "-t", f"{session}:{window}", "-p")


def fingerprint(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def estimated_tokens(text: str) -> int:
    if not text:
        return 0
    return max(1, (len(text) + 3) // 4)


def utc_timestamp() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")


def safe_component(value: str) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9._-]+", "_", value.strip())
    return cleaned or "default"


def archive_paths(session: str) -> List[Path]:
    safe_session = safe_component(session)
    return [ARCHIVE_INDEX, ARCHIVE_SESSIONS / f"{safe_session}.jsonl"]


def archive_event(record: dict) -> None:
    payload = json.dumps(record, ensure_ascii=True, sort_keys=True)
    ARCHIVE_DIR.mkdir(parents=True, exist_ok=True)
    for path in archive_paths(record["session"]):
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a") as fh:
            fh.write(payload)
            fh.write("\n")


def tail_lines(text: str, limit: int) -> List[str]:
    lines = text.splitlines()
    if limit <= 0:
        return []
    return lines[-limit:]


def latest_match(text: str, pattern: str) -> str:
    import re

    for line in reversed(text.splitlines()):
        match = re.search(pattern, line)
        if match:
            return match.group(1)
    return ""


def latest_trace_id(text: str) -> str:
    return latest_match(text, TRACE_ID_PATTERN)


def latest_parent_trace_id(text: str) -> str:
    return latest_match(text, PARENT_TRACE_ID_PATTERN)


def controller_dispatch_brief(result: ControllerTickResult, envelope: dict) -> str:
    """Render the queue-owned brief for the command the controller committed."""

    action = result.action
    if (
        action.kind != CONTROLLER_ACTION_DISPATCH
        or action.command_id is None
        or action.mission_id is None
        or action.queue_item_id is None
        or action.trace_id is None
        or action.worker_id is None
    ):
        raise RuntimeError("controller result does not contain a complete dispatch command")
    item = result.evidence.active_item(action.queue_item_id)
    if item is None:
        raise RuntimeError(
            f"queue item {action.queue_item_id} is no longer active; "
            "the durable dispatch remains reserved"
        )
    lines = [
        f"MISSION-ID: {action.mission_id}",
        f"COMMAND-ID: {action.command_id}",
        f"QUEUE-ITEM-ID: {action.queue_item_id}",
        f"TRACE-ID: {action.trace_id}",
        f"TARGET-WORKER: {action.worker_id}",
        f"PAYLOAD-DIGEST: {envelope['payload_digest']}",
        f"ACCEPT-BEFORE: {envelope['deadline_at']}",
        "BOUNDARIES: " + json.dumps(envelope["boundaries"], sort_keys=True),
        "Footprint scope is immutable. Stop and report any out-of-scope requirement;",
        "do not widen repository, planning/output paths, or shared resources while working.",
        "",
        "Before doing any work, run this receipt command exactly:",
        "env " + shlex.quote(f"COCKPIT_CONTROL_ROOT={result.root}") + " "
        + " ".join(shlex.quote(arg) for arg in (
            "cockpit-control", "accept-dispatch",
            "--command-id", str(action.command_id),
            "--mission", str(action.mission_id),
            "--worker", str(action.worker_id),
            "--queue-item", str(action.queue_item_id),
            "--trace", str(action.trace_id),
            "--payload-digest", envelope["payload_digest"],
            "--fresh-for", "300",
        )),
        "Start work ONLY on exit 0 with JSON outcome=accepted and start_work=true.",
        "duplicate/start_work=false means do not start or repeat work, even after restart.",
        "On error or uncertain output, stop and report to the overseer; do not bypass acceptance.",
        "Acceptance is lifecycle sequence 1. Publish running/heartbeats with increasing",
        "sequences and the same mission/worker/queue/trace before freshness expires.",
        "",
        f"TITLE: {item.title}",
        "",
    ]
    body = item.source_text.rstrip("\n")
    if body:
        lines.append(body)
    return "\n".join(lines) + "\n"


def deliver_controller_dispatch(
    result: ControllerTickResult,
    session: str,
    as_of: Optional[str] = None,
) -> bool:
    """Deliver one already-durable controller command to its worker pane."""

    if result.dry_run:
        return False
    if not session:
        raise RuntimeError(
            "no tmux session is available; the committed reservation requires "
            "operator inspection before recovery"
        )
    action = result.action
    target = f"{session}:{action.worker_id}"
    with PortableControlLock(result.root, command="cockpit-overseer deliver"), ExitStack() as queue_locks:
        metadata, history = inspect_control_events(result.root)
        state = fold_mission_state(history.events)
        commands, _outcomes = fold_commands(history.events)
        command = commands.get(str(action.command_id))
        slot = state.worker_slots.get(str(action.worker_id))
        if (
            slot is None
            or slot["state"] != MISSION_SLOT_RESERVED
            or slot["mission_id"] != action.mission_id
            or slot["command_id"] != action.command_id
            or slot["queue_item_id"] != action.queue_item_id
            or (action.mission_id in state.missions and
                state.missions[action.mission_id]["lifecycle"]["state"] != "pending-dispatch")
        ):
            raise RuntimeError(
                f"mission {action.mission_id} is no longer awaiting delivery; "
                "no tmux input was sent"
            )
        if command is None:
            raise RuntimeError("dispatch command is missing; no tmux input was sent")
        envelope = command["envelope"]
        deadline = envelope["deadline_at"]
        now = datetime.fromisoformat((as_of or utc_timestamp()).replace("Z", "+00:00"))
        if (
            deadline is None
            or now >= datetime.fromisoformat(deadline.replace("Z", "+00:00"))
            or command["status"] != "registered" or command["conflicts"]
            or any(holder == action.worker_id for holder, _slot, _conflict in state.contested_slots)
            or envelope["payload_digest"] != action.payload_digest
            or any(envelope["boundaries"][key] != metadata["canonical_roots"][key]
                   for key in ("queue_root", "planning_root", "implementation_roots"))
        ):
            raise RuntimeError("dispatch acceptance expired or contract changed; no tmux input was sent")
        queue_locks.enter_context(queue_lock(envelope["boundaries"]["queue_root"]))
        queue = observe_queue(Path(envelope["boundaries"]["queue_root"]))
        item = next((item for item in queue.active if item.item_id == action.queue_item_id), None)
        if (
            queue.paused or item is None or item.worker_id != action.worker_id
            or dispatch_payload_digest(item, action.mission_id, action.worker_id, action.trace_id)
            != envelope["payload_digest"]
            or item.footprint != envelope["boundaries"].get("mission_footprint")
            or _scope_conflict(item, state, commands) is not None
        ):
            raise RuntimeError("dispatch queue brief or authority changed; no tmux input was sent")
        # A retained command may already be pasted or awaiting a permission answer.
        # Only the tick that committed it may send input; a crash is unknown delivery,
        # not permission to press Enter again. The reservation is the durable fence.
        if not result.applied:
            return False
        payload = controller_dispatch_brief(result, envelope)
        with tempfile.NamedTemporaryFile("w", delete=False, encoding="utf-8") as fh:
            fh.write(payload)
            brief_path = fh.name
        try:
            paste_and_submit(brief_path, target)
        finally:
            try:
                os.unlink(brief_path)
            except FileNotFoundError:
                pass
    return True


def paste_and_submit(brief_path: str, target: str) -> None:
    """Enqueue text and one submit key, never infer worker acceptance."""

    buffer_name = "cockpit-" + Path(brief_path).name
    try:
        tmux("load-buffer", "-b", buffer_name, brief_path)
        # Preserve newlines and request bracketed paste; never use the shared
        # top buffer. tmux completion does not mean the CLI has processed paste.
        tmux("paste-buffer", "-p", "-r", "-d", "-b", buffer_name, "-t", target)
    except (RuntimeError, OSError, subprocess.SubprocessError):
        try:
            tmux("delete-buffer", "-b", buffer_name)
        except (RuntimeError, OSError, subprocess.SubprocessError) as exc:
            print(f"cockpit-overseer: buffer cleanup failed: {exc}", file=sys.stderr)
        raise
    time.sleep(PASTE_SETTLE_SECONDS)
    tmux("send-keys", "-t", target, "Enter")


def current_session() -> str:
    env_session = os.environ.get("TMUX_SESSION", "").strip()
    if env_session:
        return env_session
    try:
        return tmux("display-message", "-p", "#S").strip()
    except RuntimeError:
        return ""


def status_label(text: str) -> str:
    if any(marker in text for marker in ("● Working", "◉ Working", "◎ Working")):
        return "working"
    if "❯" in text or "ready" in text.lower():
        return "available"
    if "BLOCKED" in text or "ESCALATE" in text:
        return "stuck"
    return "idle"


def format_preview(lines: List[str]) -> str:
    return "\n".join(f"  {line}" for line in lines)


def summarize_pane(session: str, window: str, text: str, lines: int, mode: str) -> Tuple[str, dict]:
    run_id = latest_match(text, r"(RUN-[0-9]{8}-[0-9]{6}(?:-[A-Za-z0-9._-]+)?)")
    worker_state = latest_match(text, r"(WORKER-[A-Z-]+)")
    aic_used = latest_match(text, r"(AIC used[: ]+[0-9]+)")
    trace_id = latest_trace_id(text)
    parent_trace_id = latest_parent_trace_id(text)
    label = status_label(text)
    tail = tail_lines(text, lines)
    if mode == "minimal":
        tail = []

    summary_bits = []
    if run_id:
        summary_bits.append(run_id)
    if worker_state:
        summary_bits.append(worker_state)
    if trace_id:
        summary_bits.append(f"trace:{trace_id[:8]}")
    summary_bits.append(label)
    if aic_used:
        summary_bits.append(aic_used)

    summary = " | ".join(summary_bits) if summary_bits else label
    meta = {
        "hash": fingerprint(text),
        "run_id": run_id,
        "status": label,
        "line_count": len(text.splitlines()),
        "estimated_tokens": estimated_tokens(text),
        "aic_used": aic_used,
        "trace_id": trace_id,
        "parent_trace_id": parent_trace_id,
    }

    lines_out = [f"[{window}] {summary}"]
    if tail:
        lines_out.append(format_preview(tail))
    elif mode != "minimal":
        lines_out.append("  (no new tail)")
    return "\n".join(lines_out), meta


def archive_snapshot(session: str, window: str, action: str, text: str, meta: dict, mode: str, extra: Optional[dict] = None) -> None:
    record = {
        "timestamp": utc_timestamp(),
        "tool": "cockpit-overseer",
        "session": session,
        "window": window,
        "action": action,
        "mode": mode,
        "summary": meta.get("status", ""),
        "pane_hash": meta.get("hash", ""),
        "run_id": meta.get("run_id", ""),
        "line_count": meta.get("line_count", 0),
        "estimated_tokens": meta.get("estimated_tokens", 0),
        "aic_used": meta.get("aic_used", ""),
        "trace_id": meta.get("trace_id", ""),
        "parent_trace_id": meta.get("parent_trace_id", ""),
        "text": text,
    }
    if extra:
        record.update(extra)
    archive_event(record)


def cmd_loop(args: argparse.Namespace) -> int:
    args.session = args.session or current_session()
    if not args.session:
        raise SystemExit("loop requires --session or an active tmux session")
    state = load_state()
    panes = state.setdefault("panes", {})
    emitted: List[str] = []
    for window in args.window:
        try:
            text = capture(args.session, window)
        except RuntimeError as exc:
            emitted.append(f"[{window}] error: {exc}")
            continue
        summary, meta = summarize_pane(args.session, window, text, args.lines, args.mode)
        key = f"{args.session}:{window}"
        prev = panes.get(key, {})
        if prev.get("hash") == meta["hash"]:
            emitted.append(f"[{window}] steady")
        else:
            emitted.append(summary)
            panes[key] = meta
        archive_snapshot(args.session, window, "loop", text, meta, args.mode)
    save_state(state)
    print("\n".join(emitted))
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    args.session = args.session or current_session()
    if not args.session:
        raise SystemExit("status requires --session or an active tmux session")
    emitted: List[str] = []
    for window in args.window:
        try:
            text = capture(args.session, window)
        except RuntimeError as exc:
            emitted.append(f"[{window}] error: {exc}")
            continue
        summary, meta = summarize_pane(args.session, window, text, args.lines, args.mode)
        emitted.append(summary)
        archive_snapshot(args.session, window, "status", text, meta, args.mode)
    print("\n".join(emitted))
    return 0


def cmd_reset(args: argparse.Namespace) -> int:
    session = args.session or current_session() or "all"
    state = load_state()
    panes = state.setdefault("panes", {})
    if args.session:
        prefix = f"{args.session}:"
        for key in list(panes.keys()):
            if key.startswith(prefix):
                del panes[key]
    else:
        panes.clear()
    save_state(state)
    archive_event(
        {
            "timestamp": utc_timestamp(),
            "tool": "cockpit-overseer",
            "session": session,
            "window": "",
            "action": "reset",
            "mode": "n/a",
            "summary": "state cleared",
            "pane_hash": "",
            "run_id": "",
            "line_count": 0,
            "estimated_tokens": 0,
            "aic_used": "",
            "text": "",
        }
    )
    print("cockpit-overseer state cleared")
    return 0


def cmd_start(args: argparse.Namespace) -> int:
    """Initialize the durable control root before controller work begins."""

    try:
        result = initialize_control_store()
    except ControlStoreError as exc:
        print(f"cockpit-overseer: {exc}", file=sys.stderr)
        return 1
    action = "initialized" if result.created else "validated"
    print(f"cockpit-overseer: control store {action}: {result.root} (source: {result.source})")
    return 0


def pane_diagnostics(session: str, windows: List[str]) -> List[ControllerDiagnostic]:
    """Observe each worker pane as ADR-014 rule 7 and rule 8 evidence only.

    Capturing a pane is the last thing a controller does and the least thing it
    trusts.  The result is handed to the tick as a `ControllerDiagnostic`, which
    the decision function has no parameter for, so what is read here can be
    reported to an operator and can never advance authoritative state.
    """

    diagnostics: List[ControllerDiagnostic] = []
    for window in windows:
        live = CONTROLLER_LIVE_UNOBSERVED
        pane = CONTROLLER_PANE_UNOBSERVED
        if session:
            try:
                text = capture(session, window)
            except (RuntimeError, OSError):
                live = CONTROLLER_LIVE_UNREACHABLE
            else:
                live = CONTROLLER_LIVE_REACHABLE
                pane = status_label(text)
        diagnostics.append(ControllerDiagnostic.build(window, live, pane))
    return diagnostics


def cmd_tick(args: argparse.Namespace) -> int:
    """Run one bounded controller tick, then deliver its durable dispatch."""

    session = args.session or current_session()
    windows = args.window or list(DEFAULT_WINDOWS)
    try:
        result = controller_tick(
            resolve_control_root().path,
            diagnostics=pane_diagnostics(session, windows),
            as_of=args.as_of,
            dry_run=args.dry_run,
        )
        delivery_error = None
        delivered = False
        if (
            result.action.kind == CONTROLLER_ACTION_DISPATCH
            and not result.dry_run
            and (
                result.applied
                or result.fold_outcome == MISSION_FOLD_RETAINED_DUPLICATE
            )
            and not (result.command is not None and result.command.conflicted)
        ):
            try:
                delivered = deliver_controller_dispatch(result, session, as_of=args.as_of)
            except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
                delivery_error = str(exc)
        status = report_controller_tick(result)
        if delivery_error is not None:
            print(
                "cockpit-overseer: dispatch command "
                f"{result.action.command_id} is durable but delivery to "
                f"{session or '-'}:{result.action.worker_id} failed: {delivery_error} "
                "[delivery unknown; acceptance not confirmed; no automatic resubmit. "
                "Inspect command-status, mission-status and the worker before "
                "operator recover-dispatch; reservation retained]",
                file=sys.stderr,
            )
            return 1
        if delivered:
            print(
                f"delivery command {result.action.command_id} worker "
                f"{result.action.worker_id} target {session}:{result.action.worker_id} "
                "transport=enqueued acceptance=pending; worker start not confirmed"
            )
        elif status == 0 and result.action.kind == CONTROLLER_ACTION_DISPATCH and not result.dry_run:
            print(
                f"delivery command {result.action.command_id} not resent: "
                "delivery unknown; acceptance=pending; reservation retained. "
                "Inspect command-status, mission-status and the worker before "
                "operator recover-dispatch."
            )
        return status
    except ControlStoreError as exc:
        print(f"cockpit-overseer: {exc}", file=sys.stderr)
        return 1


def cmd_dispatch(args: argparse.Namespace) -> int:
    print(
        "cockpit-overseer: direct dispatch is retired because it bypasses durable "
        "mission state; enqueue the brief with `cockpit-queue enqueue`, transition "
        "it to an implementable state, then run `cockpit-overseer tick`",
        file=sys.stderr,
    )
    return 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="cockpit-overseer")
    sub = parser.add_subparsers(dest="cmd")

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-s", "--session", default=os.environ.get("TMUX_SESSION"))
    common.add_argument(
        "-w",
        "--window",
        action="append",
        default=[],
        help="tmux window to inspect; repeatable",
    )
    common.add_argument("-n", "--lines", type=int, default=5)
    common.add_argument("--mode", choices=["normal", "minimal"], default="normal")

    start = sub.add_parser("start", help="initialize the explicit versioned control store")
    start.set_defaults(func=cmd_start)

    tick = sub.add_parser(
        "tick",
        help=(
            "reconcile durable evidence in ADR-014 precedence order, take at most one "
            "state-changing action, persist it, and exit"
        ),
    )
    tick.add_argument("-s", "--session", default=os.environ.get("TMUX_SESSION"))
    tick.add_argument(
        "-w",
        "--window",
        action="append",
        default=[],
        help="worker window to observe as diagnostic-only evidence; repeatable",
    )
    tick.add_argument(
        "--as-of",
        default=None,
        metavar="UTC",
        help="reconcile at this explicit UTC moment instead of now",
    )
    tick.add_argument(
        "--dry-run",
        action="store_true",
        help="report the action that would be taken without changing any state",
    )
    tick.set_defaults(func=cmd_tick)

    loop = sub.add_parser("loop", parents=[common], help="delta-only loop snapshot")
    loop.set_defaults(func=cmd_loop)

    status = sub.add_parser("status", parents=[common], help="one-shot snapshot")
    status.set_defaults(func=cmd_status)

    reset = sub.add_parser("reset", help="clear stored snapshot state")
    reset.add_argument("-s", "--session", default="")
    reset.set_defaults(func=cmd_reset)

    dispatch = sub.add_parser("dispatch", help="retired direct mission-dispatch bypass")
    dispatch.add_argument("-s", "--session", required=True)
    dispatch.add_argument("-w", "--window", required=True)
    dispatch.add_argument("-r", "--ref", help="mission brief file to send")
    dispatch.add_argument("-m", "--message", help="inline mission brief")
    dispatch.add_argument("--trace-id", help="reuse or override the mission trace UUID")
    dispatch.add_argument("--parent-trace-id", help="explicit parent trace UUID for stitched follow-ups")
    dispatch.add_argument("--label", help="short mission label for logs")
    dispatch.set_defaults(func=cmd_dispatch)

    return parser


def main(argv: List[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "cmd", None):
        parser.print_help()
        return 0

    # `start` is the only command permitted to create the control root.  Every
    # other overseer command is fail-closed until it resolves and validates the
    # same explicit root, so no command can fall back to its working directory
    # or silently operate on incompatible control state.
    #
    # `tick` is deliberately absent from this pre-check. Architecture section 17
    # repairs a corrupt ledger by replaying the journal, so refusing the tick for
    # derived state it is about to rebuild would turn the one command that can
    # perform that repair into the one command that cannot run. The tick
    # validates committed authority itself, with the explicit repair a malformed
    # committed event requires; every other command keeps failing closed here.
    if args.cmd not in {"start", "tick"}:
        try:
            validate_control_store(resolve_control_root().path)
        except ControlStoreError as exc:
            print(f"cockpit-overseer: {exc}", file=sys.stderr)
            return 1

    if args.cmd in {"loop", "status"} and not args.window:
        args.window = list(DEFAULT_WINDOWS)

    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
