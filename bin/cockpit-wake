def _reconcile_expired_lease(
    root: Path,
    wake_id: str,
    reason: str,
    record: Dict[str, Any],
    identity: os.stat_result,
    recovered_dir: Path,
    active_path: Path,
) -> None:
    control_wake._reconcile_expired_lease(
        root,
        wake_id,
        reason,
        record,
        identity,
        recovered_dir,
        active_path,
    )


def _acquire_tick_lease(
    root: Path, wake_id: str, session: str, window: str
) -> Tuple[str, Optional[os.stat_result]]:
    return control_wake.acquire_tick_lease(root, wake_id, session, window)


def _release_tick_lease(root: Path, lease_id: str, identity: os.stat_result) -> None:
    control_wake.release_tick_lease(root, lease_id, identity)


def cmd_tick_with_lease(args):
    state = load_state()
    wake = get_awakening(state, args.id)
    root, env = require_wake_context(wake, args.id)
    session, window = wake["target"]["session"], wake["target"]["window"]
    lease_id, lease_identity = _acquire_tick_lease(root, args.id, session, window)
    if not lease_id:
        print(f"skipped: wake {args.id} duplicate lease holder", file=sys.stderr)
        sys.exit(0)

    try:
        # Stop and admission share a fence through actual process creation, not
        # merely an in-flight flag. A successful stop cannot precede a new child.
        with wake_state_lock():
            current = get_awakening(load_state(), args.id)
            if current != wake:
                raise ControlStoreError("wake changed during lease acquisition; retry after inspection")
            write_inbox(args.id, wake.get("label", ""), wake.get("message", ""),
                        datetime.now().strftime("%Y-%m-%dT%H:%M:%S"))
            process = subprocess.Popen(
                [OVERSEER_BIN, "tick", "-s", session, "-w", window],
                env=env, close_fds=True,
            )
        # Never wait under the state lock: the controller may itself read/stop
        # wakes, and operators must remain able to cancel an already-running tick.
        # close_fds also keeps the parent's lock descriptor out of the child.
        with process:
            returncode = process.wait()
        if returncode:
            return returncode
        # Keep fired cron schedules pending; never resurrect a concurrent stop.
        mark_wake_fired(args.id)
    finally:
        _release_tick_lease(root, lease_id, lease_identity)
    return 0

# ── inbox ──────────────────────────────────────────────────────────────────────
def cmd_guard_fire(args):
    """Guard a generated job invocation by consulting the persisted awakenings.

    Exit 0 only when the wake is valid and should run. Exit non-zero to
    abort the generated job; callers should treat any non-zero as a hard
    stop that prevents the controller tick from running.
    """
    state = load_state()
    a = get_awakening(state, args.id)
    if not a:
        print(f"blocked: wake entry {args.id} not found in {STATE_FILE}", file=sys.stderr)
        sys.exit(1)

    require_wake_context(a, args.id)

    # Otherwise allow the job to proceed
    sys.exit(0)

def cmd_inbox(args):
    if not INBOX_FILE.exists() or not INBOX_FILE.read_text().strip():
        print("📭 Inbox is empty — no pending awakenings.")
        return
    print(f"📬 Pending awakenings:\n")
    print(INBOX_FILE.read_text())

def cmd_inbox_clear(args):
    if INBOX_FILE.exists():
        INBOX_FILE.unlink()
    print("🧹 Inbox cleared.")

# ── schedule ───────────────────────────────────────────────────────────────────
def cmd_schedule(args):
    load_state()
    id_   = gen_id()
    once  = args.once is not None
    if once:
        at_timespec, iso_dt = parse_once_timespec(args.once)
        cron_expr    = None
        schedule_desc = f"once @ {iso_dt}"
    else:
        cron_expr = validate_cron(args.cron)
        if any(character in str(JOBS_DIR) for character in "\r\n"):
            raise ControlStoreError("cron job path must not contain line breaks")
        schedule_desc = f"cron: {cron_expr}"
        iso_dt        = None

    wake_intent = control_wake.build_wake_intent(
        id_,
        args.s,
        args.w,
        args.m,
        label=args.label or "",
        wake_type="once" if once else "cron",
        cron_expr=cron_expr,
        scheduled_at=iso_dt,
        mission=args.mission or "",
        queue_item=args.queue_item or "",
        owner=args.owner or "",
        intent=args.intent or "",
        stop_condition=args.stop_condition or "",
        cadence=cron_expr if not once else (iso_dt or ""),
        blocker_threshold=args.blocker_threshold,
        lifecycle_state=args.lifecycle or "pending",
        control_root=str(resolve_control_root().path),
    )
    entry = control_wake.wake_intent_to_dict(wake_intent)
    require_wake_context(entry, id_)
    if args.lifecycle not in (None, "pending"):
        raise ControlStoreError("new wake lifecycle must be pending")
    if args.dry_run:
        print(json.dumps({"outcome": "would-schedule", "wake": entry}, indent=2))
        return

    # All identity, cadence, boundary and capability checks precede job/state/
    # scheduler writes. Persist first so an immediately runnable job sees intent.
    with wake_state_lock():
        state = load_state()
        job_script = make_fire_script(id_)
        state["awakenings"].append(entry)
        save_state(state)
        try:
            if once:
                entry["at_job_id"] = schedule_at(at_timespec, f"{shlex.quote(job_script)}\n")
                save_state(state)
            else:
                add_cron_line(cron_expr, job_script, id_)
        except (ControlStoreError, OSError, subprocess.SubprocessError):
            # Retain cancellable evidence: at may have accepted a job despite losing
            # its response. Never discard its authoritative wake identity.
            entry["scheduler_error"] = "submission uncertain; inspect scheduler and cancel before retrying"
            save_state(state)
            raise

    print(f"✅ Scheduled  id={id_}  {schedule_desc}")
    print(f"   target : {args.s}:{args.w}")
    print(f"   message: {args.m[:80]}{'…' if len(args.m) > 80 else ''}")
    if entry["at_job_id"]:
        print(f"   at job : {entry['at_job_id']}")


def validate_cron(expression):
    """Accept portable numeric five-field cron, not shell/scheduler directives."""
    fields = expression.split()
    if len(fields) != 5 or any(c in expression for c in "\r\n\0"):
        raise ValueError("--cron requires a single five-field numeric expression")
    for field, (low, high) in zip(fields, ((0, 59), (0, 23), (1, 31), (1, 12), (0, 7))):
        for part in field.split(","):
            match = re.fullmatch(r"(\*|\d+(?:-\d+)?)(?:/(\d+))?", part)
            if not match:
                raise ValueError("--cron supports numeric lists, ranges, wildcards and positive steps")
            base, step = match.groups()
            if step is not None and not 1 <= int(step) <= high + 1:
                raise ValueError("--cron step is out of range")
            if base != "*":
                values = [int(value) for value in base.split("-")]
                if any(not low <= value <= high for value in values) or values != sorted(values):
                    raise ValueError("--cron field is out of range")
    return " ".join(fields)

# ── list ───────────────────────────────────────────────────────────────────────
def cmd_list(args):
    state = load_state()
    rows  = state["awakenings"]
    if not rows:
        print("No awakenings scheduled.")
        return
    fmt = "{:<22}  {:<5}  {:<10}  {:<19}  {:<18}  {}"
    print(fmt.format("ID", "TYPE", "STATUS", "SCHEDULED AT", "TARGET", "LABEL / MESSAGE"))
    print("─" * 100)
    icons = {"pending": "⏳", "fired": "✅", "cancelled": "❌"}
    for a in rows:
        target  = f"{a.get('session', '?')}:{a.get('window', '?')}"
        sched   = (a.get("scheduled_at") or a.get("cron_expr") or "")[:19]
        label   = a.get("label") or a.get("message", "")[:30]
        status = a.get("status", "legacy")
        icon    = icons.get(status, "?")
        print(fmt.format(
            a["id"], a.get("type", "?"),
            f"{icon} {status}", sched, target, label
        ))

# ── cancel ─────────────────────────────────────────────────────────────────────
def cmd_cancel(args):
    with wake_state_lock():
        return cancel_wake(args)

def cancel_wake(args):
    state = load_state()
    a     = get_awakening(state, args.id)
    if not a:
        print(f"❌ Not found: {args.id}")
        sys.exit(1)
    if a.get("status") == "cancelled":
        print(f"Already cancelled: {args.id}")
        return 1
    if a.get("status") == "fired" and a.get("type") != "cron":
        print(f"⚠️  Already fired: {args.id}")
        sys.exit(1)

    if a.get("type") == "once" and a.get("at_job_id"):
        remove_at_job(a["at_job_id"])
    elif a.get("type") == "cron":
        remove_cron_line(args.id)

    script = JOBS_DIR / f"{args.id}.sh"
    if script.exists():
        script.unlink()

    a["status"] = "cancelled"
    save_state(state)
    print(f"❌ Cancelled: {args.id}")

# ── fire ───────────────────────────────────────────────────────────────────────
def cmd_fire(args):
    # Never execute an old direct-message job, even when it still exists.
    result = cmd_tick_with_lease(args)
    if result == 0:
        print(f"🔥 Fired: {args.id}")
    return result

# ── status ─────────────────────────────────────────────────────────────────────
def cmd_status(args):
    from collections import Counter
    state  = load_state()
    counts = Counter(a["status"] for a in state["awakenings"])
    print(f"⏳ pending  : {counts.get('pending', 0)}")
    print(f"✅ fired    : {counts.get('fired', 0)}")
    print(f"❌ cancelled: {counts.get('cancelled', 0)}")
    print(f"   total    : {len(state['awakenings'])}")

# ── clean ──────────────────────────────────────────────────────────────────────
def cmd_clean(args):
    with wake_state_lock():
        clean_wakes()

def clean_wakes():
    state  = load_state()
    before = len(state["awakenings"])
    state["awakenings"] = [
        a for a in state["awakenings"]
        if a.get("status") not in ("fired", "cancelled")
        or (a.get("type") == "cron" and a.get("status") != "cancelled")
    ]
    save_state(state)
    print(f"🧹 Removed {before - len(state['awakenings'])} entries (fired/cancelled).")

# ── main ───────────────────────────────────────────────────────────────────────
def cmd_migrate(args):
    """Read-only adoption diagnosis; never move live metadata or rewrite history."""
    root = resolve_control_root().path
    try:
        require_ready_root(root)
    except ControlStoreError as exc:
        raise ControlStoreError(
            f"{exc}; migration is diagnostic-only: retain all live metadata and immutable "
            "history. Inspect with cockpit-control preflight. For a NEW empty control "
            "root use cockpit-control init --queue-root <absolute queue root> "
            "--planning-root <absolute planning root> --implementation-root "
            "<absolute implementation root>; never reinitialize corrupt live authority."
        ) from None
    for wake in load_state()["awakenings"]:
        try:
            control_wake.validate_wake_identity(wake)
        except ControlStoreError as exc:
            raise ControlStoreError(
                f"legacy wake {wake.get('id', '?')}: {exc}; state preserved. "
                "Inspect and stop/cancel old schedules, then explicitly reschedule with "
                "full intent. Existing scheduler scripts are not automatically migrated."
            ) from None
    print(f"control root already current: {root}; no state or history changed")


def main():
    p = argparse.ArgumentParser(
        description="cockpit-wake: schedule bounded controller ticks",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__
    )
    sub = p.add_subparsers(dest="command")

    # schedule
    ps = sub.add_parser("schedule", help="Schedule a new awakening")
    grp = ps.add_mutually_exclusive_group(required=True)
    grp.add_argument("--once", metavar="\"HH:MM [YYYY-MM-DD]\"",
                     help="One-off: fire once at this time (uses `at`)")
    grp.add_argument("--cron", metavar="EXPR",
                     help="Recurring: numeric 5-field cron (lists, ranges, wildcards, steps)")
    ps.add_argument("-s", required=True, metavar="SESSION", help="tmux session name")
    ps.add_argument("-w", required=True, metavar="WINDOW",  help="tmux window name")
    ps.add_argument("-m", required=True, metavar="MESSAGE", help="Intent note retained in the inbox (not pasted to a pane)")
    ps.add_argument("--label", metavar="TEXT", help="Human-readable label")
    ps.add_argument("--mission", help="required mission id")
    ps.add_argument("--queue-item", help="required queue item id")
    ps.add_argument("--owner", help="required owner identity")
    ps.add_argument("--intent", help="required brief intent for the wake")
    ps.add_argument("--stop-condition", help="required stop condition expression")
    ps.add_argument("--blocker-threshold", type=int, default=3, help="positive blocker threshold (default: 3)")
    ps.add_argument("--lifecycle", help="lifecycle state")
    ps.add_argument("--dry-run", action="store_true", help="validate only; no state or scheduler writes")

    sub.add_parser("list",   help="List all awakenings")
    pc = sub.add_parser("cancel", aliases=["stop"], help="Cancel a pending/recurring awakening (alias: stop)")
    pc.add_argument("id")
    pf = sub.add_parser("fire",   help="Fire an awakening immediately")
    pf.add_argument("id")
    sub.add_parser("status", help="Summary counts")
    sub.add_parser("clean",  help="Remove fired/cancelled entries")
    sub.add_parser("inbox",       help="Show unread inbox messages from fired awakenings")
    sub.add_parser("inbox-clear", help="Clear the inbox")
    sub.add_parser("migrate", help="read-only ADR-017 adoption diagnosis; no automatic wake/history migration")

    # Internal — called by fire scripts
    pi = sub.add_parser("_mark-fired"); pi.add_argument("id")
    pw = sub.add_parser("_write-inbox")
    pw.add_argument("id"); pw.add_argument("label"); pw.add_argument("msg_file"); pw.add_argument("fired_at")
    pg = sub.add_parser("_guard-fire"); pg.add_argument("id")
    pt = sub.add_parser("_tick-with-lease")
    pt.add_argument("id")
    pt.add_argument("session", nargs="?", help="legacy hint; stored target wins")
    pt.add_argument("window", nargs="?", help="legacy hint; stored target wins")

    args = p.parse_args()
    dispatch = {
        "schedule":     cmd_schedule,
        "list":         cmd_list,
        "cancel":       cmd_cancel,
        "stop":         cmd_cancel,
        "fire":         cmd_fire,
        "status":       cmd_status,
        "clean":        cmd_clean,
        "inbox":        cmd_inbox,
        "inbox-clear":  cmd_inbox_clear,
        "_mark-fired":  cmd_mark_fired,
        "_write-inbox": cmd_write_inbox,
        "_guard-fire":  cmd_guard_fire,
        "_tick-with-lease": cmd_tick_with_lease,
        "migrate":      cmd_migrate,
    }
    if args.command not in dispatch:
        p.print_help()
        sys.exit(1)
    try:
        if hasattr(args, "id") and not re.fullmatch(r"wake-[A-Za-z0-9_-]+", args.id):
            raise ControlStoreError("wake id is not a safe scheduler identity")
        if args.command in ("clean", "inbox-clear"):
            validate_control_store(resolve_control_root().path)
        return dispatch[args.command](args) or 0
    except (ControlStoreError, ValueError, OSError, subprocess.SubprocessError) as exc:
        p.exit(1, f"cockpit-wake: operationally-blocked (ADR-017): {exc}\n")

if __name__ == "__main__":
    sys.exit(main())
