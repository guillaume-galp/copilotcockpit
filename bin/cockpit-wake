#!/usr/bin/env python3
"""
cockpit-wake — schedule bounded, intent-aware controller ticks.

One-off awakenings use `at`; recurring awakenings use `cron`.
Works whether attached or detached from the tmux session.
State is persisted to ~/.config/cockpit-wake/awakenings.json.

Commands:
  schedule --once "HH:MM [YYYY-MM-DD]"  -s SESSION -w WINDOW -m MESSAGE [--label TEXT]
  schedule --cron "MIN HR DOM MON DOW"   -s SESSION -w WINDOW -m MESSAGE [--label TEXT]
  list            — table of all awakenings + status
  cancel ID       — cancel a pending or recurring awakening (alias: stop ID)
  fire   ID       — fire immediately (ad-hoc, regardless of schedule)
  status          — summary counts
  clean           — remove fired/cancelled entries from state

Schedules require --mission, --queue-item, --owner, --intent and --stop-condition.
COCKPIT_CONTROL_ROOT must name a configured store with distinct declared work roots.
--dry-run validates without writing state, jobs, inbox, leases, or scheduler entries.
Legacy direct-message schedules remain listable/cancellable without a control root;
execution requires explicit rescheduling with full identity (ADR-017).

Examples:
  cockpit-wake schedule --cron "15 7 * * 1-5" -s ulysses -w overseer \\
      -m "Check progress" --mission M-1 --queue-item QI-1 --owner operator \\
      --intent "bounded oversight" --stop-condition "mission terminal" --dry-run
  cockpit-wake list
  cockpit-wake cancel wake-1718492400
  cockpit-wake fire   wake-1718492400
"""

import argparse
import fcntl
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time
from contextlib import contextmanager
from datetime import datetime, timedelta
from pathlib import Path
from typing import Any, Dict, Optional, Tuple

import cockpit_control_wake as control_wake
from cockpit_control import (
    ControlStoreError,
    publish_control_event,
    resolve_control_root,
    validate_control_store,
    run_control_preflight,
    CONTROL_SCHEMA_VERSION,
)

# ── Paths ──────────────────────────────────────────────────────────────────────
WAKE_DIR   = Path.home() / ".config" / "cockpit-wake"
STATE_FILE = WAKE_DIR / "awakenings.json"
JOBS_DIR   = WAKE_DIR / "jobs"
SELF       = str(Path(sys.argv[0]).resolve())

def ensure_wake_dirs():
    """Create wake state directories only after command validation succeeds."""

    for directory in (WAKE_DIR, JOBS_DIR):
        directory.mkdir(parents=True, exist_ok=True)

# Resolve binaries at schedule-time so fire scripts work in minimal environments
def _bin(name):
    r = subprocess.run(["which", name], capture_output=True, text=True)
    return r.stdout.strip() or name

TMUX_BIN   = _bin("tmux")
AT_BIN     = _bin("at")
PYTHON_BIN = _bin("python3")
OVERSEER_BIN = _bin("cockpit-overseer")

control_wake.bind_facade(
    {
        "ControlStoreError": ControlStoreError,
        "publish_control_event": publish_control_event,
        "CONTROL_SCHEMA_VERSION": CONTROL_SCHEMA_VERSION,
    }
)

WAKE_LEASE_DIR = control_wake.WAKE_LEASE_DIR
WAKE_LEASE_RECOVERED_DIR = control_wake.WAKE_LEASE_RECOVERED_DIR
WAKE_LEASE_RELEASED_DIR = control_wake.WAKE_LEASE_RELEASED_DIR
WAKE_LEASE_FILE = control_wake.WAKE_LEASE_FILE
WAKE_LEASE_TTL_SECONDS = control_wake.WAKE_LEASE_TTL_SECONDS

# ── State ──────────────────────────────────────────────────────────────────────
def load_state():
    if not STATE_FILE.exists():
        return {"awakenings": []}
    with open(STATE_FILE) as f:
        state = json.load(f)
    if (not isinstance(state, dict) or not isinstance(state.get("awakenings"), list)
            or any(not isinstance(wake, dict) or not isinstance(wake.get("id"), str)
                   for wake in state["awakenings"])):
        raise ControlStoreError("malformed legacy wake state; retain it and inspect before rescheduling")
    ids = [wake["id"] for wake in state["awakenings"]]
    if len(set(ids)) != len(ids):
        raise ControlStoreError("ambiguous duplicate wake identities; retain state and inspect schedules")
    return state

def save_state(state):
    ensure_wake_dirs()
    # Readers (including cancellation and scheduler children) see a whole record.
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=WAKE_DIR, prefix=".awakenings-",
                                         delete=False) as f:
            temporary = Path(f.name)
            json.dump(state, f, indent=2)
            f.flush()
            os.fsync(f.fileno())
        os.replace(temporary, STATE_FILE)
    finally:
        if temporary is not None and temporary.exists():
            temporary.unlink()

@contextmanager
def wake_state_lock():
    """Serialize wake transactions independently of any cockpit control root."""
    ensure_wake_dirs()
    with (WAKE_DIR / "awakenings.lock").open("a") as handle:
        deadline = time.monotonic() + 5
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise ControlStoreError("wake state lock timed out; retry after the current writer")
                time.sleep(0.05)
        try:
            yield
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)

def mark_wake_fired(wake_id):
    with wake_state_lock():
        state = load_state()
        current = get_awakening(state, wake_id)
        if current and current["status"] != "cancelled":
            current["status"] = "pending" if current["type"] == "cron" else "fired"
            current["fired_at"] = datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
            save_state(state)

def get_awakening(state, id_):
    for a in state["awakenings"]:
        if a["id"] == id_:
            return a
    return None

def gen_id():
    return f"wake-{time.time_ns()}"

# ── Crontab helpers ────────────────────────────────────────────────────────────
CRON_TAG = control_wake.CRON_TAG

def read_crontab():
    return control_wake.read_crontab()

def write_crontab(lines):
    control_wake.write_crontab(lines)

def add_cron_line(cron_expr, job_script, id_):
    control_wake.add_cron_line(cron_expr, job_script, id_)

def remove_cron_line(id_):
    control_wake.remove_cron_line(id_)

# ── at helpers ─────────────────────────────────────────────────────────────────
def schedule_at(timespec, job_script):
    """Submit job_script to `at` at timespec. Returns the at job number."""
    return control_wake.schedule_at(AT_BIN, timespec, job_script)

def remove_at_job(job_number):
    control_wake.remove_at_job(job_number)

# ── Time parsing ───────────────────────────────────────────────────────────────
def parse_once_timespec(once_str):
    """
    Parse --once value into (at_timespec, iso_datetime).
    Accepted formats:
      "HH:MM"              → today or tomorrow at that time
      "HH:MM YYYY-MM-DD"   → specific date
    Returns (at_timespec_str, iso_str) — at_timespec is passed directly to `at`.
    """
    parts = once_str.strip().split()
    if not 1 <= len(parts) <= 2:
        raise ValueError("--once requires HH:MM [YYYY-MM-DD]")
    time_part = parts[0]
    hh, mm = [int(x) for x in time_part.split(":")]

    if len(parts) >= 2:
        date_part = parts[1]
        target = datetime.strptime(f"{date_part} {time_part}", "%Y-%m-%d %H:%M")
    else:
        now = datetime.now()
        candidate = now.replace(hour=hh, minute=mm, second=0, microsecond=0)
        if candidate <= now:
            candidate += timedelta(days=1)
        target = candidate
    if target <= datetime.now():
        raise ValueError("--once must be in the future")

    # `at` accepts "HH:MM MMDDYY" or "HH:MM MM/DD/YY" or natural language
    at_timespec = target.strftime("%H:%M %m/%d/%Y")
    iso_str     = target.strftime("%Y-%m-%dT%H:%M:00")
    return at_timespec, iso_str

# ── Inbox ──────────────────────────────────────────────────────────────────────
INBOX_FILE = WAKE_DIR / "inbox.md"

def write_inbox(id_, label, message, fired_at):
    ensure_wake_dirs()
    entry = f"## [{fired_at}] {label or id_}\n\n{message}\n\n---\n\n"
    with open(INBOX_FILE, "a") as f:
        f.write(entry)

# ── Fire script ────────────────────────────────────────────────────────────────
def make_fire_script(id_):
    """A scheduler holds only a locator; every invocation reloads and guards state."""
    ensure_wake_dirs()
    script  = JOBS_DIR / f"{id_}.sh"
    runtime_path = os.pathsep.join((str(Path(OVERSEER_BIN).parent), str(Path(SELF).parent)))
    content = f'''#!/usr/bin/env bash
# cockpit-wake fire script — {id_}
# Auto-generated — do not edit manually.
export HOME={shlex.quote(str(Path.home()))}
export PATH={shlex.quote(runtime_path)}:"$PATH"
exec {shlex.quote(PYTHON_BIN)} {shlex.quote(SELF)} _tick-with-lease {shlex.quote(id_)}
'''
    script.write_text(content)
    script.chmod(0o755)
    return str(script)

# ── Internal sub-commands (called by fire scripts) ─────────────────────────────
def cmd_mark_fired(args):
    a = get_awakening(load_state(), args.id)
    require_wake_context(a, args.id)
    mark_wake_fired(args.id)

def cmd_write_inbox(args):
    wake = get_awakening(load_state(), args.id)
    require_wake_context(wake, args.id)
    write_inbox(args.id, wake.get("label", ""), wake.get("message", ""), args.fired_at)


def require_ready_root(root):
    """Validate canonical identity and supported preflight without any writes."""
    metadata = validate_control_store(root)
    roots = metadata["canonical_roots"]
    queue = roots.get("queue_root")
    planning = roots.get("planning_root")
    implementations = roots.get("implementation_roots")
    if not queue or not planning or not implementations:
        raise ControlStoreError(
            "required queue/planning/implementation boundaries are absent; use "
            "cockpit-control bind-roots with explicit absolute work roots"
        )
    paths = [str(root), queue, planning, *implementations]
    if any(not Path(path).is_absolute() for path in paths):
        raise ControlStoreError("all wake control/work roots must be absolute")
    canonical = [Path(path).resolve() for path in paths]
    if len(set(canonical)) != len(canonical):
        raise ControlStoreError("wake control and work roots must be distinct")
    # Preflight compares queue environment with metadata. Stored canonical state
    # wins at wake execution time, including after shell/tmux context loss.
    old_queue = os.environ.get("COCKPIT_QUEUE_ROOT")
    try:
        os.environ["COCKPIT_QUEUE_ROOT"] = queue
        report = run_control_preflight(root, source="stored wake")
    finally:
        if old_queue is None:
            os.environ.pop("COCKPIT_QUEUE_ROOT", None)
        else:
            os.environ["COCKPIT_QUEUE_ROOT"] = old_queue
    if report.blocked:
        details = "; ".join(f"{f.dimension}: {f.detail}" for f in report.actionable)
        raise ControlStoreError(f"preflight {report.status}: {details}; run cockpit-control preflight")
    return queue


def require_wake_context(wake, wake_id):
    if not isinstance(wake, dict):
        raise ControlStoreError(f"wake entry {wake_id} not found in {STATE_FILE}")
    allowed, message = control_wake.guard_wake_fire(wake, wake_id, STATE_FILE)
    if not allowed:
        raise ControlStoreError(message)
    root = Path(wake["control_root"])
    queue = require_ready_root(root)
    return root, control_wake.wake_environment(wake, queue)


